<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Console Admin - Vadd Studio</title>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@phosphor-icons/web"></script>

    <style>
        /* --- ROOT VARIABLES --- */
        :root {
            --bg-main: #05110a; --bg-panel: #0a1f14; --bg-hover: #113320;
            --border-color: #1a3a26; --color-green: #4ade80; --color-orange: #f97316;
            --color-orange-hover: #ea580c; --color-text-main: #f3f4f6;
            --color-text-muted: #9ca3af; --font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* --- RESET & BASIC --- */
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: var(--font-family); }
        body { background-color: var(--bg-main); color: var(--color-text-main); height: 100vh; overflow: hidden; display: flex; }

        /* --- LAYOUT --- */
        .sidebar { width: 260px; background-color: var(--bg-panel); border-right: 1px solid var(--border-color); display: flex; flex-direction: column; transition: transform 0.3s ease; z-index: 50; }
        .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow: hidden; }

        /* --- SIDEBAR --- */
        .sidebar-header { height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 20px; border-bottom: 1px solid var(--border-color); background-color: var(--bg-main); }
        .logo-container { display: flex; align-items: center; gap: 10px; }
        .logo-icon { width: 32px; height: 32px; border-radius: 50%; background-color: var(--bg-panel); border: 2px solid var(--color-green); display: flex; align-items: center; justify-content: center; color: var(--color-green); font-size: 12px; font-weight: bold; }
        .logo-text { font-size: 20px; font-weight: bold; }
        .logo-text span:first-child { color: var(--color-green); }
        .nav-menu { padding: 20px 12px; flex: 1; overflow-y: auto; }
        .nav-label { font-size: 12px; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: 10px; padding-left: 12px; font-weight: 600; }
        .nav-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: none; border: none; width: 100%; color: var(--color-text-muted); font-size: 15px; cursor: pointer; border-radius: 8px; margin-bottom: 5px; border-left: 4px solid transparent; transition: all 0.2s; text-align: left; }
        .nav-item:hover { background-color: var(--bg-hover); color: var(--color-text-main); }
        .nav-item.active { background-color: var(--bg-hover); color: var(--color-green); border-left-color: var(--color-green); }
        .nav-item i { font-size: 20px; }
        
        /* Tombol Close Sidebar (Hanya tampil di HP) */
        .close-sidebar-btn { display: none; background: none; border: none; color: var(--color-text-muted); font-size: 24px; cursor: pointer; }

        /* --- TOP HEADER --- */
        .top-header { height: 64px; display: flex; align-items: center; justify-content: space-between; padding: 0 24px; background-color: var(--bg-main); border-bottom: 1px solid var(--border-color); }
        .header-left { display: flex; align-items: center; gap: 15px; }
        .page-title { font-size: 18px; font-weight: 600; }
        
        /* Tombol Hamburger Menu (Hanya tampil di HP) */
        .menu-btn { display: none; background: none; border: none; color: var(--color-text-main); font-size: 24px; cursor: pointer; }

        /* --- CONTENT AREA --- */
        .content-area { flex: 1; padding: 24px; overflow-y: auto; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* --- STATS --- */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; margin-bottom: 30px; }
        .stat-card { background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; }
        .stat-title { color: var(--color-text-muted); font-size: 14px; margin-bottom: 10px; }
        .stat-value { font-size: 28px; font-weight: bold; display: flex; align-items: baseline; gap: 10px; }
        .stat-desc { font-size: 12px; color: var(--color-text-muted); margin-top: 5px; }

        /* --- POSTS --- */
        .posts-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; flex-wrap: wrap; gap: 15px; }
        .btn-primary { background-color: var(--color-orange); color: #fff; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 600; display: flex; align-items: center; gap: 8px; cursor: pointer; transition: background 0.2s; font-size: 14px; }
        .btn-primary:hover { background-color: var(--color-orange-hover); }

        .posts-list { background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden; }
        .post-item { display: flex; padding: 16px; border-bottom: 1px solid var(--border-color); gap: 16px; align-items: center; transition: background 0.2s; }
        .post-item:last-child { border-bottom: none; }
        .post-item:hover { background-color: #0c2619; }
        .post-thumb { width: 150px; height: 85px; border-radius: 8px; background-color: var(--bg-hover); object-fit: cover; border: 1px solid var(--border-color); }
        .post-info { flex: 1; min-width: 0; }
        .post-title { font-size: 16px; font-weight: 600; margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .post-meta { display: flex; align-items: center; gap: 12px; font-size: 13px; color: var(--color-text-muted); flex-wrap: wrap; }
        
        .post-category { background-color: rgba(17, 51, 32, 0.5); color: var(--color-green); border: 1px solid #2a5a3a; padding: 2px 8px; border-radius: 4px; font-size: 12px; }
        .ep-badge { background-color: rgba(249, 115, 22, 0.1); color: var(--color-orange); border: 1px solid var(--color-orange); padding: 2px 8px; border-radius: 4px; font-size: 12px; font-weight: 600; }
        
        .post-actions { display: flex; gap: 8px; }
        .action-btn { background: none; border: none; color: var(--color-text-muted); width: 36px; height: 36px; border-radius: 8px; display: flex; align-items: center; justify-content: center; cursor: pointer; font-size: 18px; transition: all 0.2s; }
        .action-btn:hover { background-color: var(--bg-hover); color: var(--color-text-main); }
        .action-btn.delete:hover { background-color: rgba(248, 113, 113, 0.1); color: #f87171; }

        .loading-state, .empty-state { padding: 40px; text-align: center; color: var(--color-text-muted); }

        /* --- MODAL EPISODE --- */
        .modal-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.8); backdrop-filter: blur(4px); z-index: 100; display: none; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.3s ease; }
        .modal-overlay.active { display: flex; opacity: 1; }
        .modal-content { background-color: var(--bg-panel); border: 1px solid var(--border-color); border-radius: 12px; width: 90%; max-width: 650px; max-height: 85vh; display: flex; flex-direction: column; overflow: hidden; transform: scale(0.95); transition: transform 0.3s ease; }
        .modal-overlay.active .modal-content { transform: scale(1); }
        .modal-header { padding: 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background-color: var(--bg-main); }
        .modal-body { padding: 20px; overflow-y: auto; flex: 1; }
        
        .ep-list-item { display: flex; align-items: center; gap: 15px; padding: 12px; border-bottom: 1px solid var(--border-color); border-radius: 8px; margin-bottom: 8px; flex-wrap: wrap; }
        .ep-list-item:hover { background-color: var(--bg-hover); }
        .ep-thumb-sm { width: 100px; height: 56px; border-radius: 6px; object-fit: cover; background: #000; border: 1px solid var(--border-color); }
        .ep-info { flex: 1; min-width: 150px; }
        .ep-title-text { font-size: 15px; font-weight: bold; color: #fff; }
        .ep-sub-text { font-size: 12px; color: var(--color-text-muted); margin-top: 4px; }

        /* --- RESPONSIVE MOBILE (YANG SEMPAT HILANG) --- */
        .overlay { display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 40; }
        .overlay.active { display: block; }

        @media (max-width: 768px) {
            .sidebar { position: fixed; top: 0; bottom: 0; left: -100%; z-index: 50; }
            .sidebar.open { left: 0; }
            .close-sidebar-btn, .menu-btn { display: block; }
            
            .post-item { flex-direction: column; align-items: flex-start; }
            .post-thumb { width: 100%; height: auto; aspect-ratio: 16/9; }
            .post-actions { width: 100%; justify-content: flex-end; border-top: 1px solid var(--border-color); padding-top: 10px; margin-top: 5px; }
        }
    </style>
</head>
<body>

    <!-- OVERLAY UNTUK HP -->
    <div class="overlay" id="mobileOverlay"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <div class="logo-container">
                <div class="logo-icon">VS</div>
                <div class="logo-text"><span>vadd</span> <span>studio</span></div>
            </div>
            <!-- TOMBOL CLOSE SIDEBAR DI HP -->
            <button class="close-sidebar-btn" id="closeSidebar"><i class="ph ph-x"></i></button>
        </div>
        <nav class="nav-menu">
            <div class="nav-label">Menu Utama</div>
            <button class="nav-item active" data-tab="dashboard">
                <i class="ph ph-squares-four"></i> Dashboard
            </button>
            <button class="nav-item" data-tab="posts">
                <i class="ph ph-film-strip"></i> Kelola Series
            </button>
        </nav>
    </aside>

    <!-- MAIN CONTENT WRAPPER -->
    <div class="main-wrapper">
        <header class="top-header">
            <div class="header-left">
                <!-- TOMBOL BUKA SIDEBAR DI HP -->
                <button class="menu-btn" id="openSidebar"><i class="ph ph-list"></i></button>
                <h1 class="page-title" id="headerTitle">Ringkasan Dashboard</h1>
            </div>
        </header>

        <main class="content-area">
            
            <!-- TAB: DASHBOARD -->
            <div id="tab-dashboard" class="tab-content active">
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-title">Total Series</div>
                        <div class="stat-value" id="dashTotalSeries">...</div>
                        <div class="stat-desc">Database Aktif</div>
                    </div>
                     <div class="stat-card">
                        <div class="stat-title">Total Episode</div>
                        <div class="stat-value" id="dashTotalEps">...</div>
                        <div class="stat-desc">Tersedia</div>
                    </div>
                </div>
            </div>

            <!-- TAB: POSTS / SERIES -->
            <div id="tab-posts" class="tab-content">
                <div class="posts-header">
                    <div>
                        <h2 style="font-size: 20px; margin-bottom: 4px;">Daftar Judul Series / Film</h2>
                        <p style="font-size: 14px; color: var(--color-text-muted);">Klik ikon list untuk melihat dan mengelola episode.</p>
                    </div>
                    <button class="btn-primary" onclick="window.location.href='post.html'">
                        <i class="ph ph-plus"></i> Buat Judul Baru
                    </button>
                </div>

                <div class="posts-list" id="postsContainer">
                    <div class="loading-state">
                        <i class="ph ph-spinner ph-spin" style="font-size: 32px; margin-bottom: 10px;"></i>
                        <p>Mengambil data dari database...</p>
                    </div>
                </div>
            </div>

        </main>
    </div>

    <!-- MODAL DAFTAR EPISODE -->
    <div class="modal-overlay" id="episodeModal">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h3 style="font-size:18px; font-weight:bold; color:#fff;" id="modalSeriesTitle">Daftar Episode</h3>
                    <p style="font-size:12px; color:var(--color-text-muted);">Kelola semua episode untuk judul ini.</p>
                </div>
                <button class="action-btn" onclick="closeEpModal()"><i class="ph ph-x"></i></button>
            </div>
            <div class="modal-body" id="modalEpList">
                <div class="loading-state">Memuat episode...</div>
            </div>
        </div>
    </div>

    <script type="module">
        import { db } from './js/firebase-init.js';
        import { collection, getDocs, deleteDoc, doc, query, where, orderBy } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        // --- LOGIKA UI MOBILE SIDEBAR ---
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('mobileOverlay');
        
        window.openMobileSidebar = () => {
            sidebar.classList.add('open');
            overlay.classList.add('active');
        };

        window.closeMobileSidebar = () => {
            sidebar.classList.remove('open');
            overlay.classList.remove('active');
        };

        document.getElementById('openSidebar').addEventListener('click', openMobileSidebar);
        document.getElementById('closeSidebar').addEventListener('click', closeMobileSidebar);
        overlay.addEventListener('click', closeMobileSidebar);


        // --- LOGIKA FIREBASE ---
        let allEpisodesCache = [];

        async function fetchSeriesData() {
            const container = document.getElementById('postsContainer');
            try {
                // Ambil Episode
                const epSnapshot = await getDocs(collection(db, "episodes"));
                allEpisodesCache = [];
                epSnapshot.forEach(doc => allEpisodesCache.push({ id: doc.id, ...doc.data() }));

                // Ambil Series
                const querySnapshot = await getDocs(collection(db, "series"));
                const seriesData = [];
                querySnapshot.forEach(doc => seriesData.push({ id: doc.id, ...doc.data() }));

                // Update Dashboard stats
                document.getElementById('dashTotalSeries').innerText = seriesData.length;
                document.getElementById('dashTotalEps').innerText = allEpisodesCache.length;

                renderSeries(seriesData);
            } catch (error) {
                console.error(error);
                container.innerHTML = `<div class="empty-state">Gagal memuat data. ${error.message}</div>`;
            }
        }

        function renderSeries(data) {
            const container = document.getElementById('postsContainer');
            container.innerHTML = ''; 

            if (data.length === 0) {
                container.innerHTML = '<div class="empty-state">Belum ada judul/series.</div>'; return;
            }

            data.forEach(item => {
                const banner = item.bannerUrl || item.banner_url || 'https://via.placeholder.com/400x225?text=No+Banner';
                const totalEp = allEpisodesCache.filter(ep => ep.seriesId === item.id).length;

                const postHTML = `
                    <div class="post-item">
                        <img src="${banner}" alt="Banner" class="post-thumb">
                        <div class="post-info">
                            <div class="post-title">${item.title || 'Tanpa Judul'}</div>
                            <div class="post-meta">
                                <span class="post-category">${item.category || 'Uncategorized'}</span>
                                <span class="ep-badge"><i class="ph ph-video-camera"></i> ${totalEp} Episode</span>
                            </div>
                        </div>
                        <div class="post-actions">
                            <button class="action-btn" style="color:var(--color-green);" title="Lihat Episode" onclick="openEpModal('${item.id}', '${item.title}')"><i class="ph ph-list-numbers"></i></button>
                            <button class="action-btn" title="Edit Judul"><i class="ph ph-pencil-simple"></i></button>
                            <button class="action-btn delete" title="Hapus Judul" onclick="deleteSeriesData('${item.id}')"><i class="ph ph-trash"></i></button>
                        </div>
                    </div>
                `;
                container.innerHTML += postHTML;
            });
        }

        // --- MODAL EPISODE ---
        const epModal = document.getElementById('episodeModal');
        const modalTitle = document.getElementById('modalSeriesTitle');
        const modalList = document.getElementById('modalEpList');

        window.openEpModal = async (seriesId, seriesTitle) => {
            modalTitle.innerText = `Episode: ${seriesTitle}`;
            modalList.innerHTML = '<div class="loading-state">Memuat episode...</div>';
            epModal.classList.add('active');

            try {
                // PERBAIKAN: Hapus "orderBy" di query Firebase untuk mencegah Error Index
                const q = query(collection(db, "episodes"), where("seriesId", "==", seriesId));
                const snapshot = await getDocs(q);
                
                if(snapshot.empty) {
                    modalList.innerHTML = '<div class="empty-state" style="padding:20px;">Belum ada episode untuk judul ini.</div>';
                    return;
                }

                // PERBAIKAN: Masukkan data ke array, lalu urutkan angkanya menggunakan JavaScript
                let epArray = [];
                snapshot.forEach(doc => epArray.push({ id: doc.id, ...doc.data() }));
                
                // Urutkan berdasarkan episodeNumber (Dari terkecil ke terbesar)
                epArray.sort((a, b) => (a.episodeNumber || 0) - (b.episodeNumber || 0));

                modalList.innerHTML = '';
                epArray.forEach(ep => {
                    const thumb = ep.thumbnailUrl || 'https://via.placeholder.com/100x56?text=No+Thumb';
                    
                    // PERBAIKAN: Mengamankan format tanggal agar tidak error jika data baru disubmit
                    let dateStr = 'Baru saja';
                    if (ep.createdAt && typeof ep.createdAt.toDate === 'function') {
                        dateStr = new Date(ep.createdAt.toDate()).toLocaleDateString('id-ID');
                    }
                    
                    const epItem = `
                        <div class="ep-list-item">
                            <img src="${thumb}" class="ep-thumb-sm">
                            <div class="ep-info">
                                <div class="ep-title-text">Eps ${ep.episodeNumber} - ${ep.episodeTitle || 'Tanpa Judul'}</div>
                                <div class="ep-sub-text">Ditambahkan pada: ${dateStr}</div>
                            </div>
                            <div class="post-actions">
                                <button class="action-btn" title="Edit Episode" onclick="editEpisode('${ep.id}')"><i class="ph ph-pencil-simple"></i></button>
                                <button class="action-btn delete" title="Hapus Episode" onclick="deleteEpisode('${ep.id}', '${seriesId}', '${seriesTitle}')"><i class="ph ph-trash"></i></button>
                            </div>
                        </div>
                    `;
                    modalList.innerHTML += epItem;
                });
            } catch(e) {
                console.error(e);
                // Menampilkan detail error di layar agar lebih mudah dilacak jika terjadi lagi
                modalList.innerHTML = `<div class="empty-state">Gagal memuat daftar episode.<br><span style="font-size:10px; color:red;">${e.message}</span></div>`;
            }
        }


        window.closeEpModal = () => { epModal.classList.remove('active'); }
        
        epModal.addEventListener('click', (e) => {
            if(e.target === epModal) closeEpModal();
        });

        // --- EDIT & HAPUS ---
        window.editEpisode = (epId) => {
            window.location.href = `post.html?editEp=${epId}`;
        }

        window.deleteEpisode = async (epId, seriesId, seriesTitle) => {
            if(confirm("Yakin ingin menghapus episode ini secara permanen?")) {
                try {
                    await deleteDoc(doc(db, "episodes", epId));
                    alert("Episode berhasil dihapus!");
                    openEpModal(seriesId, seriesTitle);
                    fetchSeriesData(); 
                } catch(e) { alert("Gagal menghapus."); console.error(e); }
            }
        }

        window.deleteSeriesData = async (id) => {
            if(confirm("Yakin ingin menghapus Series ini? Catatan: Hapus manual episodenya juga!")) {
                await deleteDoc(doc(db, "series", id));
                fetchSeriesData(); 
            }
        }

        // INIT LOAD
        fetchSeriesData();

        // NAVIGASI TAB
        const navItems = document.querySelectorAll('.nav-item');
        const tabContents = document.querySelectorAll('.tab-content');
        const headerTitle = document.getElementById('headerTitle');

        navItems.forEach(item => {
            item.addEventListener('click', function() {
                const targetTab = this.getAttribute('data-tab');
                if(!targetTab) return;
                navItems.forEach(nav => nav.classList.remove('active'));
                tabContents.forEach(tab => tab.classList.remove('active'));
                this.classList.add('active');
                document.getElementById('tab-' + targetTab).classList.add('active');
                if(targetTab === 'dashboard') headerTitle.textContent = "Ringkasan Dashboard";
                if(targetTab === 'posts') headerTitle.textContent = "Kelola Series";
                closeMobileSidebar(); // Otomatis tutup sidebar jika di HP
            });
        });
    </script>
</body>
</html>
