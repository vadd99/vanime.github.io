<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title id="page-title">Memuat... - Vadd Studio</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700;900&family=Montserrat:wght@500;700;800;900&display=swap" rel="stylesheet">
    
    <!-- CSS Modular -->
    <link rel="stylesheet" href="css/base.css">
    <link rel="stylesheet" href="css/layout.css">
    <link rel="stylesheet" href="css/components.css">
    <link rel="stylesheet" href="css/detail.css">            
</head>
<body>

    <div id="layout-wrapper"></div>

    <template id="page-content">
        <div class="detail-page-wrapper">
            
            <!-- Hero Section -->
            <header class="detail-hero">
                <div class="detail-hero-bg">
                    <img id="detail-banner" src="https://via.placeholder.com/1600x600?text=Memuat..." alt="Cover">
                    <div class="detail-hero-gradient"></div>
                </div>

                <div class="detail-hero-content">
                    <h1 class="series-logo-title" id="detail-title">
                        Memuat...
                        <span id="detail-category">...</span>
                    </h1>

                    <div class="meta-info-bar">
                        <span class="age-badge" id="hero-age-badge">13+</span>
                        <!-- Teks Sub | Dub dan titik pemisahnya sudah dihapus di sini -->
                    </div>

                    <div class="rating-box" id="rating-container">
                        <div style="color:var(--color-text-muted); font-size:12px;">Menghitung rating...</div>
                    </div>

                    <div class="action-buttons-group">
                        <a href="#" class="btn-watch-main" id="btn-watch-hero" style="display:none;">
                            <i class="fas fa-play"></i> MULAI MENONTON E1
                        </a>
                        <button class="btn-square-icon toggle-bookmark" aria-label="Simpan Bookmark">
                            <i class="far fa-bookmark"></i>
                        </button>
                    </div>

                    <div class="secondary-actions">
                        <div class="action-item toggle-bookmark">
                            <i class="fas fa-plus"></i>
                            <span>DAFTARKU</span>
                        </div>
                        <div class="action-item" id="btn-share">
                            <i class="fas fa-share-alt"></i>
                            <span>BAGIKAN</span>
                        </div>
                    </div>
                </div>
            </header>

            <div class="content-container">
                <div class="synopsis-box">
                    <div class="synopsis-content-wrapper" id="synopsis-wrapper">
                        <!-- Teks Sinopsis Utama -->
                        <p class="synopsis-text" id="synopsis-text">
                            Sedang memuat data sinopsis...
                        </p>
                        
                        <!-- Metadata Tambahan (Audio, Subtitle, dll) -->
                        <div class="extra-details" id="extra-details-container">
                            <p id="detail-audio" style="display:none;"><strong>Audio:</strong> <span></span></p>
                            <p id="detail-subtitle" style="display:none;"><strong>Takarir:</strong> <span></span></p>
                            <p id="detail-warnings" style="display:none;"><strong>Peringatan Konten:</strong> <span></span></p>
                            <p id="detail-genre" style="display:none;"><strong>Genre:</strong> <span></span></p>
                        </div>
                    </div>

                    <button class="btn-more-detail" id="btn-toggle-synopsis">
                        LEBIH BANYAK DETAIL <i class="fas fa-chevron-down icon-arrow"></i>
                    </button>
                </div>

                <!-- Bagian Daftar Episode -->
                <div class="episodes-header">
                    <div class="season-select-wrapper">
                        <button class="season-dropdown">
                            Daftar Episode <i class="fas fa-chevron-down season-arrow"></i>
                        </button>
                    </div>
                </div>

                <div class="episode-list" id="episode-container">
                    <div style="color:#9ca3af; padding: 20px;">Memuat episode...</div>
                </div>
            </div>

            <!-- Sticky Mobile Bar -->
            <div class="sticky-mobile-bar">
                <a href="#" class="btn-watch-main" id="btn-watch-mobile" style="display:none;">
                    <i class="fas fa-play"></i> MULAI MENONTON
                </a>
                <button class="btn-square-icon toggle-bookmark" aria-label="Bookmark">
                    <i class="far fa-bookmark"></i>
                </button>
            </div>

            <div id="vadd-toast">Berhasil ditambahkan ke Daftarku!</div>
        </div>
    </template>

    <script src="js/main.js"></script>
    <script type="module" src="js/detail.js"></script>    
</body>
</html>
