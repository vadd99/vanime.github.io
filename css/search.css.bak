/* ==========================================
   STYLESHEET KHUSUS PENCARIAN (css/search.css)
   ========================================== */

.search-page-wrapper {
    max-width: 1280px;
    margin: 100px auto 4rem auto; 
    padding: 0 1rem;
    min-height: 50vh; 
}

.search-header {
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--vadd-card, #0a1f14);
    padding-bottom: 1.25rem;
}

.search-header h2 {
    color: #ffffff;
    font-size: 1.8rem;
    font-weight: 800;
    font-family: 'Montserrat', sans-serif;
}

/* Grid Layout Poster */
.search-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr); /* 2 kolom di HP agar pas */
    gap: 1rem;
}

/* Card Series Style */
.search-card {
    text-decoration: none;
    display: flex;
    flex-direction: column;
    background-color: var(--vadd-card, #0c2016);
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    transition: transform 0.2s ease, border-color 0.2s;
}

.search-card:hover {
    transform: translateY(-4px);
    border-color: var(--vadd-primary, #4ade80);
}

.search-thumb-wrapper {
    width: 100%;
    aspect-ratio: 3 / 4; /* Rasio poster vertikal */
    overflow: hidden;
    background-color: #000;
}

.search-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
}

.search-card:hover .search-thumb {
    transform: scale(1.05);
}

.search-card-info {
    padding: 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    justify-content: space-between;
}

.search-title {
    color: #ffffff;
    font-size: 0.9rem;
    font-weight: 700;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.search-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    margin-top: 0.2rem;
}

.search-category {
    background-color: rgba(96, 211, 129, 0.1);
    color: var(--vadd-primary, #4ade80);
    padding: 2px 6px;
    border-radius: 4px;
    font-weight: 600;
    text-transform: lowercase;
}

.search-rating {
    color: var(--vadd-gold, #facc15);
    font-weight: 700;
}

.search-rating i {
    margin-right: 2px;
}

/* State Kosong / Loading */
.loading-state, .empty-state {
    grid-column: 1 / -1; 
    text-align: center;
    padding: 3rem 1rem;
    color: #9ca3af;
    font-size: 1.1rem;
}

.empty-state i {
    font-size: 3rem;
    color: var(--vadd-card);
    margin-bottom: 1rem;
    display: block;
}

/* Media Queries Desktop */
@media (min-width: 768px) {
    .search-grid {
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1.5rem;
    }
}
