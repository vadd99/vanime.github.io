<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Buat/Edit Postingan - Vadd Studio</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        vs: {
                            bg: '#05110a', panel: '#0a1f14', border: '#1a3a26',
                            green: '#4ade80', orange: '#f97316', 'orange-hover': '#ea580c', hover: '#113320'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        .tab-active { border-bottom: 2px solid #4ade80; color: #4ade80; font-weight: bold; }
        .tab-inactive { border-bottom: 2px solid transparent; color: #9ca3af; }
        .tab-inactive:hover { color: #ffffff; }
        
        /* Multiple Select Styles */
        .select-multiple {
            height: auto;
            min-height: 2.5rem;
        }
        .select-multiple option {
            padding: 0.5rem;
            margin-bottom: 0.25rem;
            border-radius: 0.25rem;
        }
        .select-multiple option:checked {
            background-color: #1a3a26 linear-gradient(0deg, #1a3a26 0%, #1a3a26 100%);
            color: #4ade80;
        }
        /* Hide scrollbar for multiple select but allow scrolling */
        .select-multiple::-webkit-scrollbar {
            width: 8px;
        }
        .select-multiple::-webkit-scrollbar-track {
            background: #05110a; 
            border-radius: 4px;
        }
        .select-multiple::-webkit-scrollbar-thumb {
            background: #1a3a26; 
            border-radius: 4px;
        }
        .select-multiple::-webkit-scrollbar-thumb:hover {
            background: #4ade80; 
        }
    </style>
</head>
<body class="bg-vs-bg text-gray-200 font-sans min-h-screen flex flex-col selection:bg-vs-green selection:text-vs-bg">

    <header class="h-16 flex items-center justify-between px-6 bg-vs-bg border-b border-vs-border sticky top-0 z-30">
        <div class="flex items-center gap-3">
            <a href="admin.html" class="text-gray-400 hover:text-white transition-colors" title="Kembali ke Dashboard">
                <i data-lucide="arrow-left" class="w-5 h-5"></i>
            </a>
            <div class="flex items-center gap-2 border-l border-vs-border pl-3 ml-1">
                <div class="w-8 h-8 rounded-full bg-vs-border border-2 border-vs-green flex items-center justify-center overflow-hidden text-xs font-bold text-vs-green">VS</div>
                <span class="text-lg font-bold tracking-tight hidden sm:block">
                  <span class="text-vs-green">vadd</span> <span class="text-white">studio</span> <span class="text-gray-500 font-normal text-sm ml-2">Console</span>
                </span>
            </div>
        </div>
    </header>

    <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-8 relative">
        <div class="max-w-5xl mx-auto space-y-6 animate-[fadeIn_0.5s_ease-out]">
            
            <div class="border-b border-vs-border pb-0">
                <h1 class="text-2xl font-bold text-white mb-4" id="page-main-title">Kelola Konten Video</h1>
                <div class="flex gap-6">
                    <button id="tab-btn-series" class="pb-3 tab-active transition-colors flex items-center gap-2">
                        <i data-lucide="folder-plus" class="w-5 h-5"></i> Tambah Judul Seri
                    </button>
                    <button id="tab-btn-episode" class="pb-3 tab-inactive transition-colors flex items-center gap-2">
                        <i data-lucide="video" class="w-5 h-5"></i> Tambah / Edit Episode
                    </button>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                <!-- FORM -->
                <div>
                    <!-- FORM 1: SERI -->
                    <form id="form-series" class="bg-vs-panel border border-vs-border rounded-xl p-6 space-y-5 shadow-xl">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Judul Anime/Seri <span class="text-red-500">*</span></label>
                            <input type="text" id="seriesTitle" required class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                        </div>

                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1">Genre / Kategori <span class="text-xs text-gray-500">(Tahan Ctrl/Cmd untuk pilih banyak)</span></label>
                                <div class="flex gap-2">
                                    <select id="seriesGenre" multiple size="4" class="select-multiple flex-1 w-full bg-vs-bg border border-vs-border rounded-lg py-2 px-3 text-white focus:border-vs-green focus:outline-none">
                                        <!-- Options injected by JS -->
                                    </select>
                                    <div class="flex flex-col gap-2">
                                        <button type="button" id="addGenreBtn" class="bg-vs-hover border border-vs-border p-2.5 rounded-lg text-vs-green hover:bg-vs-green hover:text-vs-bg transition-colors h-[42px]" title="Tambah Genre Baru"><i data-lucide="plus" class="w-5 h-5"></i></button>
                                        <button type="button" id="clearGenreBtn" class="bg-vs-hover border border-vs-border p-2.5 rounded-lg text-red-400 hover:bg-red-500 hover:text-white transition-colors h-[42px]" title="Bersihkan Pilihan"><i data-lucide="x" class="w-5 h-5"></i></button>
                                    </div>
                                </div>
                                <p class="text-xs text-vs-green mt-1 hidden" id="selected-genres-text">Terpilih: <span id="selected-genres-list"></span></p>
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1">Rating Usia</label>
                                <select id="seriesAge" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                                    <option value="" disabled selected>Pilih Rating Usia...</option>
                                    <option value="13+">13+ (Remaja)</option>
                                    <option value="16+">16+ (Dewasa Muda)</option>
                                    <option value="18+">18+ (Dewasa)</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Peringatan Konten</label>
                            <input type="text" id="seriesWarning" placeholder="Kekerasan, Konten Seksual, Perkataan Kasar" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                        </div>

                        <div class="grid grid-cols-1 gap-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1">Audio Languages</label>
                                <div class="flex gap-2">
                                    <select id="seriesAudio" class="flex-1 w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                                        <option value="" disabled selected>Pilih Audio...</option>
                                    </select>
                                    <button type="button" id="addAudioBtn" class="bg-vs-hover border border-vs-border p-2.5 rounded-lg text-vs-green hover:bg-vs-green hover:text-vs-bg transition-colors" title="Tambah Audio Baru"><i data-lucide="plus" class="w-5 h-5"></i></button>
                                </div>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-gray-300 mb-1">Subtitle Languages</label>
                                <div class="flex gap-2">
                                    <select id="seriesSubtitle" class="flex-1 w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                                        <option value="" disabled selected>Pilih Subtitle...</option>
                                    </select>
                                    <button type="button" id="addSubtitleBtn" class="bg-vs-hover border border-vs-border p-2.5 rounded-lg text-vs-green hover:bg-vs-green hover:text-vs-bg transition-colors" title="Tambah Subtitle Baru"><i data-lucide="plus" class="w-5 h-5"></i></button>
                                </div>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Banner (Path Github)</label>
                            <input type="text" id="seriesBanner" placeholder="banner/1.jpg" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Deskripsi</label>
                            <textarea id="seriesDesc" rows="3" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none resize-y"></textarea>
                        </div>

                        <div class="pt-4 flex justify-end">
                            <button type="submit" id="btn-submit-series" class="bg-vs-green hover:bg-green-500 text-vs-bg px-6 py-2.5 rounded-lg font-bold flex items-center gap-2">
                                <i data-lucide="save" class="w-4 h-4"></i> Simpan Judul
                            </button>
                        </div>
                    </form>

                    <!-- FORM 2: EPISODE & SERVER EMBED DINAMIS -->
                    <form id="form-episode" class="bg-vs-panel border border-vs-border rounded-xl p-6 space-y-5 shadow-xl hidden">
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Pilih Judul Seri <span class="text-red-500">*</span></label>
                            <select id="epSeriesSelect" required class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                                <option value="" disabled selected>Memuat data seri...</option>
                            </select>
                        </div>
                        <div class="grid grid-cols-3 gap-4">
                            <div class="col-span-1">
                                <label class="block text-sm font-medium text-gray-300 mb-1">Eps Ke- <span class="text-red-500">*</span></label>
                                <input type="number" id="epNumber" min="1" required class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                            </div>
                            <div class="col-span-2">
                                <label class="block text-sm font-medium text-gray-300 mb-1">Judul Episode</label>
                                <input type="text" id="epTitle" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-300 mb-1">Thumbnail (Path Github)</label>
                            <input type="text" id="epThumb" placeholder="thumbnail/1.jpg" class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                        </div>

                        <!-- BAGIAN PENGATURAN SERVER VIDEO -->
                        <div class="border-t border-vs-border pt-4 space-y-3">
                            <div class="flex items-center justify-between">
                                <label class="block text-sm font-medium text-vs-green">Daftar Server & URL Embed <span class="text-red-500">*</span></label>
                                <button type="button" id="openServerModalBtn" class="bg-vs-hover border border-vs-border text-xs px-3 py-1.5 rounded-lg text-vs-green hover:bg-vs-green hover:text-vs-bg transition-colors flex items-center gap-1 font-bold">
                                    <i data-lucide="plus" class="w-4 h-4"></i> Tambah Server Baru
                                </button>
                            </div>
                            <p class="text-xs text-gray-400">Masukkan link embed (iframe / direct link) untuk masing-masing server di bawah ini.</p>
                            
                            <!-- Container tempat kotak input URL server muncul secara dinamis -->
                            <div id="servers-input-container" class="space-y-4">
                                <!-- Kotak input server akan digenerate otomatis oleh Javascript di sini -->
                            </div>
                        </div>

                        <div class="pt-4 flex justify-end">
                            <button type="submit" id="btn-submit-ep" class="bg-vs-orange hover:bg-vs-orange-hover text-white px-6 py-2.5 rounded-lg font-bold flex items-center gap-2">
                                <i data-lucide="upload" class="w-4 h-4"></i> Posting Episode
                            </button>
                        </div>
                    </form>
                </div>

                <!-- PREVIEW -->
                <div class="bg-vs-panel border border-vs-border rounded-xl p-6 shadow-xl hidden lg:block">
                    <h2 class="text-sm font-bold text-gray-400 mb-4 uppercase tracking-wider flex items-center gap-2">
                        <i data-lucide="eye" class="w-4 h-4"></i> Live Preview
                    </h2>
                    <div id="preview-series" class="relative w-full aspect-video rounded-xl border border-vs-border bg-vs-bg shadow-2xl flex items-center justify-center text-gray-500">
                        Isi form seri di kiri...
                    </div>
                    <div id="preview-episode" class="hidden space-y-4">
                        <div class="flex gap-4 p-3 rounded-lg bg-vs-hover/40 border border-transparent">
                            <div class="relative w-32 aspect-video rounded bg-vs-bg overflow-hidden shrink-0 border border-vs-border">
                                <div id="prev-e-bg" class="absolute inset-0 bg-cover bg-center"></div>
                            </div>
                            <div class="flex flex-col justify-center">
                                <span id="prev-e-series" class="text-[10px] text-gray-400 uppercase font-bold">PILIH SERI</span>
                                <h4 id="prev-e-title" class="text-sm font-bold text-white mt-1">E1 - Judul</h4>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- MODAL TAMBAH NAMA SERVER -->
    <div id="serverModal" class="fixed inset-0 bg-black/80 backdrop-blur-sm z-50 flex items-center justify-center hidden">
        <div class="bg-vs-panel border border-vs-border rounded-xl p-6 w-full max-w-md shadow-2xl space-y-4 animate-[fadeIn_0.3s_ease-out]">
            <div class="flex justify-between items-center">
                <h3 class="text-lg font-bold text-white flex items-center gap-2">
                    <i data-lucide="server" class="w-5 h-5 text-vs-green"></i> Tambah Nama Server Baru
                </h3>
                <button type="button" id="closeServerModal" class="text-gray-400 hover:text-white">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>
            <div>
                <label class="block text-sm font-medium text-gray-300 mb-1">Nama Server <span class="text-red-500">*</span></label>
                <input type="text" id="modalServerNameInput" placeholder="Contoh: Mega, Doodstream, Gofile..." class="w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white focus:border-vs-green focus:outline-none">
                <p class="text-xs text-gray-400 mt-1">Nama ini akan langsung tersimpan dan muncul sebagai pilihan kotak URL.</p>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" id="cancelServerModal" class="px-4 py-2 rounded-lg text-sm bg-vs-hover border border-vs-border text-gray-300 hover:text-white">Batal</button>
                <button type="button" id="saveServerModalBtn" class="px-5 py-2 rounded-lg text-sm font-bold bg-vs-green text-vs-bg hover:bg-green-500 transition-colors">Simpan Server</button>
            </div>
        </div>
    </div>

    <script type="module">
        import { db } from './js/firebase-init.js'; 
        import { collection, addDoc, getDocs, getDoc, doc, updateDoc, query, orderBy, serverTimestamp } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-firestore.js";

        document.addEventListener('DOMContentLoaded', async () => {
            lucide.createIcons();

            const tabSeriesBtn = document.getElementById('tab-btn-series');
            const tabEpisodeBtn = document.getElementById('tab-btn-episode');
            const formSeries = document.getElementById('form-series');
            const formEpisode = document.getElementById('form-episode');
            
            // State penampung daftar server yang aktif di form episode ini
            let activeServers = [
                { id: 'srv_default', name: 'Google Drive', url: '' }
            ];

            const urlParams = new URLSearchParams(window.location.search);
            const editEpId = urlParams.get('editEp'); 
            const editSeriesId = urlParams.get('editSeries'); 
            let isEditEpMode = false;
            let isEditSeriesMode = false;

            function switchTab(tab) {
                if (tab === 'series') {
                    tabSeriesBtn.className = "pb-3 tab-active transition-colors flex items-center gap-2";
                    tabEpisodeBtn.className = "pb-3 tab-inactive transition-colors flex items-center gap-2";
                    formSeries.classList.remove('hidden'); formEpisode.classList.add('hidden');
                    document.getElementById('preview-series').classList.remove('hidden');
                    document.getElementById('preview-episode').classList.add('hidden');
                } else {
                    tabSeriesBtn.className = "pb-3 tab-inactive transition-colors flex items-center gap-2";
                    tabEpisodeBtn.className = "pb-3 tab-active transition-colors flex items-center gap-2";
                    formSeries.classList.add('hidden'); formEpisode.classList.remove('hidden');
                    document.getElementById('preview-series').classList.add('hidden');
                    document.getElementById('preview-episode').classList.remove('hidden');
                }
            }

            tabSeriesBtn.addEventListener('click', () => switchTab('series'));
            tabEpisodeBtn.addEventListener('click', () => switchTab('episode'));

            // --- RENDER KOTAK INPUT URL BERDASARKAN activeServers ---
            function renderServersInputs() {
                const container = document.getElementById('servers-input-container');
                container.innerHTML = '';

                if (activeServers.length === 0) {
                    container.innerHTML = '<p class="text-xs text-gray-500 italic">Belum ada server ditambahkan. Klik "Tambah Server Baru" di atas.</p>';
                    return;
                }

                activeServers.forEach((srv, index) => {
                    const card = document.createElement('div');
                    card.className = "bg-vs-bg/60 border border-vs-border rounded-xl p-4 space-y-2 relative group";
                    card.innerHTML = `
                        <div class="flex justify-between items-center">
                            <span class="text-sm font-bold text-vs-green flex items-center gap-2">
                                <i data-lucide="server" class="w-4 h-4"></i> ${srv.name}
                            </span>
                            ${activeServers.length > 1 ? `<button type="button" onclick="window.removeServerCard('${srv.id}')" class="text-red-400 hover:text-red-300 text-xs flex items-center gap-1"><i data-lucide="trash-2" class="w-3.5 h-3.5"></i> Hapus</button>` : ''}
                        </div>
                        <div>
                            <input type="url" placeholder="Masukkan URL Embed untuk ${srv.name} (https://...)" data-id="${srv.id}" value="${srv.url || ''}" class="server-url-input w-full bg-vs-bg border border-vs-border rounded-lg py-2.5 px-3 text-white text-sm focus:border-vs-green focus:outline-none" required />
                        </div>
                    `;
                    container.appendChild(card);
                });
                lucide.createIcons();
            }

            // Fungsi global untuk menghapus server dari list
            window.removeServerCard = function(id) {
                activeServers = activeServers.filter(s => s.id !== id);
                renderServersInputs();
            };

            // --- LOGIKA MODAL TAMBAH NAMA SERVER ---
            const serverModal = document.getElementById('serverModal');
            const openServerModalBtn = document.getElementById('openServerModalBtn');
            const closeServerModal = document.getElementById('closeServerModal');
            const cancelServerModal = document.getElementById('cancelServerModal');
            const saveServerModalBtn = document.getElementById('saveServerModalBtn');
            const modalServerNameInput = document.getElementById('modalServerNameInput');

            openServerModalBtn.addEventListener('click', () => {
                serverModal.classList.remove('hidden');
                modalServerNameInput.value = '';
                modalServerNameInput.focus();
            });

            function hideServerModal() {
                serverModal.classList.add('hidden');
            }

            closeServerModal.addEventListener('click', hideServerModal);
            cancelServerModal.addEventListener('click', hideServerModal);

            saveServerModalBtn.addEventListener('click', () => {
                const srvName = modalServerNameInput.value.trim();
                if(!srvName) {
                    alert("Nama server tidak boleh kosong!");
                    return;
                }

                // Buat ID unik berdasarkan nama
                const newId = 'srv_' + Date.now();
                activeServers.push({
                    id: newId,
                    name: srvName,
                    url: ''
                });

                renderServersInputs();
                hideServerModal();
            });

            // Tangkap perubahan nilai input URL secara real-time
            document.addEventListener('input', (e) => {
                if (e.target.classList.contains('server-url-input')) {
                    const id = e.target.getAttribute('data-id');
                    const targetSrv = activeServers.find(s => s.id === id);
                    if (targetSrv) {
                        targetSrv.url = e.target.value.trim();
                    }
                }
            });

            // Inisialisasi awal render input server
            renderServersInputs();

            // Fungsi Untuk Memasukkan Nilai ke Dalam Dropdown Select (Single Select)
            function populateSelect(elementId, items) {
                const select = document.getElementById(elementId);
                const firstOption = select.options[0]; 
                select.innerHTML = ''; 
                select.appendChild(firstOption);
                
                items.filter(i => i).sort().forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item;
                    opt.textContent = item;
                    select.appendChild(opt);
                });
            }

            // Fungsi Untuk Memasukkan Nilai ke Dalam Multiple Select (Genre)
            function populateMultipleSelect(elementId, items) {
                const select = document.getElementById(elementId);
                select.innerHTML = ''; 
                
                items.filter(i => i).sort().forEach(item => {
                    const opt = document.createElement('option');
                    opt.value = item;
                    opt.textContent = item;
                    select.appendChild(opt);
                });
            }

            const eSeries = document.getElementById('epSeriesSelect');
            async function loadSeriesData() {
                const q = query(collection(db, "series"), orderBy("title", "asc"));
                const snapshot = await getDocs(q);
                eSeries.innerHTML = '<option value="" disabled selected>Pilih Judul Seri...</option>';
                
                let genresSet = new Set();
                let audiosSet = new Set();
                let subsSet = new Set();

                snapshot.forEach((doc) => {
                    const data = doc.data();
                    const opt = document.createElement('option');
                    opt.value = doc.id; opt.textContent = data.title;
                    opt.dataset.title = data.title; 
                    eSeries.appendChild(opt);

                    if(data.genres) data.genres.split(',').forEach(i => genresSet.add(i.trim()));
                    if(data.audioLanguages) data.audioLanguages.split(',').forEach(i => audiosSet.add(i.trim()));
                    if(data.subtitleLanguages) data.subtitleLanguages.split(',').forEach(i => subsSet.add(i.trim()));
                });

                populateMultipleSelect('seriesGenre', Array.from(genresSet));
                populateSelect('seriesAudio', Array.from(audiosSet));
                populateSelect('seriesSubtitle', Array.from(subsSet));
            }

            await loadSeriesData();

            // Handle Update Genre Selection Text
            const seriesGenreSelect = document.getElementById('seriesGenre');
            const selectedGenresText = document.getElementById('selected-genres-text');
            const selectedGenresList = document.getElementById('selected-genres-list');

            function updateGenreSelectionText() {
                const selectedOptions = Array.from(seriesGenreSelect.selectedOptions).map(opt => opt.value);
                if (selectedOptions.length > 0) {
                    selectedGenresText.classList.remove('hidden');
                    selectedGenresList.textContent = selectedOptions.join(', ');
                } else {
                    selectedGenresText.classList.add('hidden');
                    selectedGenresList.textContent = '';
                }
            }

            seriesGenreSelect.addEventListener('change', updateGenreSelectionText);

            document.getElementById('clearGenreBtn').addEventListener('click', () => {
                seriesGenreSelect.selectedIndex = -1; // Clear selection
                updateGenreSelectionText();
            });

            // Handle Add Option for Single Select (Audio/Subtitle)
            function handleAddOption(btnId, selectId, promptText) {
                document.getElementById(btnId).addEventListener('click', () => {
                    const newVal = prompt(promptText);
                    if(newVal && newVal.trim() !== '') {
                        const select = document.getElementById(selectId);
                        const opt = document.createElement('option');
                        opt.value = newVal.trim();
                        opt.textContent = newVal.trim();
                        select.appendChild(opt);
                        select.value = newVal.trim();
                    }
                });
            }
            
            // Handle Add Option for Multiple Select (Genre)
            document.getElementById('addGenreBtn').addEventListener('click', () => {
                const newVal = prompt('Masukkan Genre / Kategori Baru:');
                if(newVal && newVal.trim() !== '') {
                    const select = document.getElementById('seriesGenre');
                    
                    // Cek apakah sudah ada
                    const exists = Array.from(select.options).some(opt => opt.value.toLowerCase() === newVal.trim().toLowerCase());
                    
                    if (!exists) {
                        const opt = document.createElement('option');
                        opt.value = newVal.trim();
                        opt.textContent = newVal.trim();
                        opt.selected = true; // Langsung terpilih
                        select.appendChild(opt);
                        updateGenreSelectionText();
                    } else {
                        // Jika sudah ada, langsung pilih
                        Array.from(select.options).forEach(opt => {
                            if (opt.value.toLowerCase() === newVal.trim().toLowerCase()) {
                                opt.selected = true;
                            }
                        });
                        updateGenreSelectionText();
                    }
                }
            });

            handleAddOption('addAudioBtn', 'seriesAudio', 'Masukkan Bahasa Audio Baru:');
            handleAddOption('addSubtitleBtn', 'seriesSubtitle', 'Masukkan Bahasa Subtitle Baru:');

            document.getElementById('seriesAge').addEventListener('change', function(e) {
                const warningInput = document.getElementById('seriesWarning');
                if (e.target.value === '13+') warningInput.value = 'Kekerasan Ringan, Bahasa Kasar Ringan';
                else if (e.target.value === '16+') warningInput.value = 'Kekerasan, Bahasa Kasar, Tema Dewasa';
                else if (e.target.value === '18+') warningInput.value = 'Kekerasan Ekstrem, Konten Seksual, Darah, Bahasa Kasar';
            });

            function setSelectValue(selectId, value) {
                const select = document.getElementById(selectId);
                let optionExists = Array.from(select.options).some(opt => opt.value === value);
                if(value && !optionExists) {
                    const opt = document.createElement('option');
                    opt.value = value;
                    opt.textContent = value;
                    select.appendChild(opt);
                }
                select.value = value || '';
            }

            function setMultipleSelectValues(selectId, valuesString) {
                const select = document.getElementById(selectId);
                select.selectedIndex = -1; // Reset selection
                
                if (!valuesString) return;
                
                const values = valuesString.split(',').map(v => v.trim());
                
                values.forEach(val => {
                    let optionExists = Array.from(select.options).some(opt => opt.value === val);
                    if(val && !optionExists) {
                        const opt = document.createElement('option');
                        opt.value = val;
                        opt.textContent = val;
                        select.appendChild(opt);
                    }
                });

                Array.from(select.options).forEach(opt => {
                    if (values.includes(opt.value)) {
                        opt.selected = true;
                    }
                });
            }

            // --- LOGIKA EDIT EPISODE ---
            if(editEpId) {
                isEditEpMode = true;
                switchTab('episode'); 
                document.getElementById('page-main-title').innerText = "Edit Episode";
                
                const btnSubmit = document.getElementById('btn-submit-ep');
                btnSubmit.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Simpan Perubahan';
                btnSubmit.classList.replace('bg-vs-orange', 'bg-vs-green');
                btnSubmit.classList.replace('hover:bg-vs-orange-hover', 'hover:bg-green-500');

                try {
                    const epDoc = await getDoc(doc(db, "episodes", editEpId));
                    if(epDoc.exists()) {
                        const data = epDoc.data();
                        
                        eSeries.value = data.seriesId;
                        document.getElementById('epNumber').value = data.episodeNumber;
                        document.getElementById('epTitle').value = data.episodeTitle || '';
                        document.getElementById('epThumb').value = data.thumbnailUrl || '';
                        
                        let serversList = data.servers || [];
                        if(serversList.length === 0 && data.embedUrl) {
                            serversList = [{ name: "Google Drive", url: data.embedUrl }];
                        }
                        if(serversList.length === 0) {
                            serversList = [{ name: "Google Drive", url: "" }];
                        }

                        // Petakan ulang ke state activeServers
                        activeServers = serversList.map((srv, idx) => ({
                            id: 'srv_edit_' + idx,
                            name: srv.name || 'Server',
                            url: srv.url || ''
                        }));

                        renderServersInputs();

                        document.getElementById('prev-e-series').textContent = data.seriesTitle;
                        document.getElementById('prev-e-title').textContent = `E${data.episodeNumber} - ${data.episodeTitle}`;
                        document.getElementById('prev-e-bg').style.backgroundImage = `url('${data.thumbnailUrl}')`;
                    }
                } catch(e) {
                    console.error("Gagal menarik data edit:", e);
                }
            } 
            else if (editSeriesId) {
                isEditSeriesMode = true;
                switchTab('series'); 
                document.getElementById('page-main-title').innerText = "Edit Judul Seri";
                
                const btnSubmitSeries = document.getElementById('btn-submit-series');
                btnSubmitSeries.innerHTML = '<i data-lucide="save" class="w-4 h-4"></i> Simpan Perubahan';
                
                try {
                    const seriesDoc = await getDoc(doc(db, "series", editSeriesId));
                    if(seriesDoc.exists()) {
                        const data = seriesDoc.data();
                        document.getElementById('seriesTitle').value = data.title || '';
                        setMultipleSelectValues('seriesGenre', data.genres);
                        updateGenreSelectionText(); // Update the text display
                        setSelectValue('seriesAge', data.ageRating);
                        setSelectValue('seriesAudio', data.audioLanguages);
                        setSelectValue('seriesSubtitle', data.subtitleLanguages);
                        document.getElementById('seriesWarning').value = data.contentWarnings || '';
                        document.getElementById('seriesBanner').value = data.bannerUrl || '';
                        document.getElementById('seriesDesc').value = data.description || '';
                    }
                } catch(e) {
                    console.error("Gagal menarik data seri:", e);
                }
            }

            // --- SUBMIT FORM EPISODE ---
            document.getElementById('form-episode').addEventListener('submit', async (e) => {
                e.preventDefault();
                const btn = document.getElementById('btn-submit-ep');
                const origText = btn.innerHTML;
                btn.innerHTML = 'Memproses...'; btn.disabled = true;

                const serversArray = [];
                activeServers.forEach(srv => {
                    if(srv.name && srv.url) {
                        serversArray.push({ name: srv.name, url: srv.url });
                    }
                });

                if(serversArray.length === 0) {
                    alert("Harap masukkan minimal 1 URL embed untuk server yang tersedia!");
                    btn.innerHTML = origText; btn.disabled = false;
                    return;
                }

                const epData = {
                    seriesId: eSeries.value, 
                    seriesTitle: eSeries.options[eSeries.selectedIndex].dataset.title, 
                    episodeNumber: Number(document.getElementById('epNumber').value), 
                    episodeTitle: document.getElementById('epTitle').value.trim(),
                    thumbnailUrl: document.getElementById('epThumb').value.trim(), 
                    servers: serversArray 
                };

                try {
                    if(isEditEpMode) {
                        await updateDoc(doc(db, "episodes", editEpId), epData);
                        alert(`Perubahan Episode ${epData.episodeNumber} berhasil disimpan!`);
                        window.location.href = 'admin.html';
                    } else {
                        epData.createdAt = serverTimestamp();
                        await addDoc(collection(db, "episodes"), epData);
                        alert(`Episode ${epData.episodeNumber} berhasil diposting!`);
                        document.getElementById('form-episode').reset();
                        activeServers = [{ id: 'srv_default', name: 'Google Drive', url: '' }];
                        renderServersInputs();
                    }
                } catch (error) {
                    alert("Gagal memproses. Error: " + error.message);
                } finally {
                    btn.innerHTML = origText; btn.disabled = false;
                }
            });

            // --- SUBMIT FORM SERI ---
            document.getElementById('form-series').addEventListener('submit', async(e)=>{
               e.preventDefault();
               const btn = document.getElementById('btn-submit-series');
               const origText = btn.innerHTML;
               btn.innerHTML = 'Memproses...'; btn.disabled = true;
               
               // Get all selected genres
               const selectedGenres = Array.from(document.getElementById('seriesGenre').selectedOptions).map(opt => opt.value);
               
               if (selectedGenres.length === 0) {
                   alert("Harap pilih minimal 1 genre!");
                   btn.innerHTML = origText; btn.disabled = false;
                   return;
               }

               const seriesData = {
                    title: document.getElementById('seriesTitle').value.trim(), 
                    genres: selectedGenres.join(', '), // Save as comma separated string
                    ageRating: document.getElementById('seriesAge').value || '',
                    audioLanguages: document.getElementById('seriesAudio').value || '',
                    subtitleLanguages: document.getElementById('seriesSubtitle').value || '',
                    contentWarnings: document.getElementById('seriesWarning').value.trim(),
                    bannerUrl: document.getElementById('seriesBanner').value.trim(), 
                    description: document.getElementById('seriesDesc').value.trim()
               };

               try {
                   if (isEditSeriesMode) {
                       await updateDoc(doc(db, "series", editSeriesId), seriesData);
                       alert('Perubahan Judul Seri Berhasil Disimpan!');
                       window.location.href = 'admin.html';
                   } else {
                       seriesData.createdAt = serverTimestamp();
                       await addDoc(collection(db, "series"), seriesData);
                       alert('Judul Seri Baru Berhasil Tersimpan!'); 
                       e.target.reset(); 
                       document.getElementById('seriesGenre').selectedIndex = -1;
                       updateGenreSelectionText();
                       document.getElementById('seriesAge').selectedIndex = 0;
                       document.getElementById('seriesAudio').selectedIndex = 0;
                       document.getElementById('seriesSubtitle').selectedIndex = 0;
                       loadSeriesData(); 
                       switchTab('episode');
                   }
               } catch(err) { 
                   alert("Gagal menyimpan seri: " + err.message); 
               } finally {
                   btn.innerHTML = origText; btn.disabled = false;
               }
            });
        });
    </script>
</body>
</html>
